<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.service.voice.VoiceInteractionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
    </queries>

    <!-- Issue #1 P0：system_server(uid 1000) → App 跨 UID 回传通道。
         exported=true + signature 权限：system 发送方被 AMS 组件检查短路放行，
         第三方应用因不持有本签名权限而无法伪造/投递。 -->
    <permission
        android:name="com.ouhuan.oplusassistant.permission.REPORT"
        android:protectionLevel="signature" />

    <application
        android:name=".app.AssistApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ouhuan">

        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Ouhuan.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AssistantPickerActivity"
            android:exported="false"
            android:label="@string/picker_title"
            android:theme="@style/Theme.Ouhuan.NoActionBar" />

        <activity
            android:name=".ui.LogsActivity"
            android:exported="false"
            android:label="@string/logs_title" />

        <activity
            android:name=".ui.DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <receiver
            android:name=".data.LogEntryReceiver"
            android:exported="true"
            android:permission="com.ouhuan.oplusassistant.permission.REPORT">
            <intent-filter>
                <action android:name="com.ouhuan.oplusassistant.action.LOG_EVENT" />
                <action android:name="com.ouhuan.oplusassistant.action.STATE_REPORT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
