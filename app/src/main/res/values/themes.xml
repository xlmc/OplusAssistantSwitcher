<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ouhuan" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">@color/ouhuan_bg</item>
    </style>

    <style name="Theme.Ouhuan.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ouhuan_bg</item>
    </style>

    <style name="SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 卡片主标题（参考图 h2） -->
    <style name="CardTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ouhuan_text_main</item>
    </style>

    <!-- 卡片内正文（参考图 body） -->
    <style name="CardBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ouhuan_text_body</item>
    </style>

    <!-- 卡片内次级信息（参考图 small） -->
    <style name="CardSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ouhuan_text_small</item>
    </style>
</resources>
